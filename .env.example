# ── Telegram Bot ──────────────────────────────────
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# ── Auth Dashboard ────────────────────────────────
JWT_SECRET=ganti_dengan_string_acak_panjang

# ── Pakasir Payment Gateway ───────────────────────
PAKASIR_PROJECT=slug_proyek_kamu
PAKASIR_API_KEY=api_key_dari_pakasir

# ── App URL (untuk webhook Pakasir) ───────────────
# Isi dengan URL Railway kamu tanpa trailing slash
APP_URL=https://xxx.up.railway.app

# PORT otomatis dari Railway, tidak perlu diisi
